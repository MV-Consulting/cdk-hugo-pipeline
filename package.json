{
  "name": "@mavogel/cdk-hugo-pipeline",
  "description": "Build you hugo website all on AWS with CI/CD and a dev environment.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MV-Consulting/cdk-hugo-pipeline"
  },
  "scripts": {
    "build": "projen build",
    "bump": "projen bump",
    "clobber": "projen clobber",
    "compat": "projen compat",
    "compile": "projen compile",
    "default": "projen default",
    "docgen": "projen docgen",
    "eject": "projen eject",
    "eslint": "projen eslint",
    "package": "projen package",
    "package-all": "projen package-all",
    "package:js": "projen package:js",
    "post-compile": "projen post-compile",
    "pre-compile": "projen pre-compile",
    "release": "projen release",
    "test": "projen test",
    "test:watch": "projen test:watch",
    "unbump": "projen unbump",
    "watch": "projen watch",
    "projen": "projen",
    "prepare": "husky",
    "awslint": "awslint",
    "integ-test": "integ-runner --directory ./integ-tests --parallel-regions eu-west-1 --parallel-regions eu-west-2 --update-on-failed"
